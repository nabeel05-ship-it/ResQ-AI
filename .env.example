# ==============================================================================
# ResQ AI — Environment Variables
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# Note: In Create React App, only environment variables prefixed with REACT_APP_
# are exposed to the client bundle via process.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq API (Required for online AI features)
# ------------------------------------------------------------------------------
# Used by:
#   - Online emergency first-aid chat guidance (Llama 3.1 8B Instant)
#   - Multimodal camera triage & injury classification (Llama 4 Scout)
#   - Multilingual voice transcription (Whisper Large v3 Turbo)
#   - Smart query extraction for tutorial videos
#
# Get your API key from Groq Console: https://console.groq.com/keys
REACT_APP_GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. RapidAPI (Optional — for YouTube first-aid tutorial videos)
# ------------------------------------------------------------------------------
# Used by:
#   - Fetching relevant first-aid video tutorials in RelatedVideos.js
#
# Get your API key from RapidAPI: https://rapidapi.com
# Subscribe to YouTube v2 or YouTube v31 on RapidAPI.
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# RapidAPI YouTube host:
# Default: youtube-v2.p.rapidapi.com
# Alternative supported host: youtube-v31.p.rapidapi.com
REACT_APP_RAPIDAPI_HOST=youtube-v2.p.rapidapi.com
